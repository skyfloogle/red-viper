; 1/256, -255/256, 1/512, -1
.constf const1(0.00390625, -0.99609375, 0.000244140625, -1.0)

.bool left
.fvec a_offset

; position is transposed
; v0: (x1, y1, u1, v1)
; v1: (uoff1, voff1, uright1, vright1)
; v2: (x2, y2, u2, v2)
; v3: (uoff2, voff2, uright2, vright2)
; uoff1 & voff1 are always 0, the other uv values are identical for 1 and 2

.out outpos dummy
.out outtc0 dummy

.entry vmain_affine
.proc vmain_affine
    ; position: 0..size -> -1..1
    add r0.xy, a_offset.xy, v0.xy
    add r0.zw, a_offset.xyxy, v2.xyxy
    mul r0.xyzw, const1.xxxx, r0.xyzw
    add r0.xyzw, const1.wwww, r0.xyzw
    mov outpos.xyzw, r0.yxwz
    ; texcoord: 0..size -> 0..1
    mov r0.xy, v0.zw
    mov r0.zw, v2.zwzw
    add r0.zw, r0.zwzw, v3.xyxy
    jmpu left, postright
    add r0.xyzw, r0.xyzw, v1.zwzw
    postright:
    mul r0.xyzw, const1.zzzz, r0.xyzw
    mov outtc0, r0
    end
.end
